# Optional local settings. The server reads exported environment variables,
# not this file automatically. No credentials are needed for the local pilot.
HOST=127.0.0.1
PORT=8000
ACADEMY_DB=/workspace/academy-data/academy.sqlite3
# Set to 1 only when served behind an HTTPS reverse proxy.
ACADEMY_SECURE_COOKIES=0
# Optional local AI, disabled by default. No model is installed or downloaded.
# The model must already exist in Ollama on this server at 127.0.0.1:11434.
# Cloud model variants are rejected. Local inference also consumes CPU/RAM.
ACADEMY_AI_PROVIDER=disabled
# ACADEMY_AI_MODEL=exact-name-of-an-installed-local-model

# Account email is optional and disabled until the operator configures SMTP.
ACADEMY_MAIL_MODE=disabled
# Set SMTP_HOST, SMTP_PORT (465 or 587), SMTP_USER, SMTP_PASSWORD and SMTP_FROM
# with the ACADEMY_ prefix in a secure environment, never in committed files.
# Email links also require ACADEMY_APP_ORIGIN (the real application origin).

# Optional production mode requires the pinned requirements-runtime.txt.
# ACADEMY_ENV=production
# ACADEMY_APP_ORIGIN=https://YOUR-REAL-APPLICATION-HOST
# ACADEMY_SECURE_COOKIES=1
# ACADEMY_DB must then be an explicit absolute path outside the source folder.
# ACADEMY_TRUSTED_PROXY is optional: one explicit proxy IP, never a wildcard.
